    <!-- Non-intrusive Toast Notification -->
    <div id="toast">Copied to clipboard!</div>

    <script>
        function showToast(msg) {
            const t = document.getElementById('toast');
            if (!t) return;
            t.innerText = msg;
            t.classList.add('show');
            clearTimeout(window.__toastTimeout);
            window.__toastTimeout = setTimeout(() => t.classList.remove('show'), 2400);
        }

        function copyText(val) {
            if (!val || val === '—') return;
            navigator.clipboard.writeText(val);
            showToast('Copied: ' + val);
        }

        function filterTable() {
            const q = document.getElementById('searchInput').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#tableBody tr');
            let visible = 0;
            rows.forEach(r => {
                const data = r.getAttribute('data-search') || '';
                if (!q || data.includes(q)) {
                    r.style.display = '';
                    visible++;
                } else {
                    r.style.display = 'none';
                }
            });
            document.getElementById('visibleCount').innerText = visible;
        }

        async function triggerSync(isSilent = false) {
            const btn = document.getElementById('sync-text');
            const icon = document.getElementById('sync-icon');
            if (!isSilent && btn && icon) {
                btn.innerText = 'Syncing...';
                icon.innerText = '⏳';
                showToast('Syncing transactions from PhonePe...');
            }

            try {
                const resp = await fetch('/api/v1/db/sync', { method: 'POST' });
                const res = await resp.json();
                if (res.success) {
                    if (!isSilent) showToast('✅ Synced ' + (res.count || 0) + ' transactions!');
                    if (typeof refreshTableData === 'function') {
                        await refreshTableData();
                    }
                } else if (!isSilent) {
                    showToast('Notice: ' + (res.message || res.error || 'Failed'));
                }
            } catch (e) {
                if (!isSilent) showToast('Sync error: ' + e.toString());
            } finally {
                if (!isSilent && btn && icon) {
                    btn.innerText = 'Sync from PhonePe';
                    icon.innerText = '🔄';
                }
            }
        }

        function exportCSV() {
            const table = document.getElementById('transactionsTable');
            let csv = [];
            for (let row of table.rows) {
                let cols = [];
                for (let cell of row.cells) {
                    let text = cell.innerText.replace(/\s+/g, ' ').replace('📋', '').trim();
                    cols.push('"' + text.replace(/"/g, '""') + '"');
                }
                csv.push(cols.join(','));
            }
            const blob = new Blob([csv.join('\n')], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'PhonePe_Transactions_' + new Date().toISOString().slice(0, 10) + '.csv';
            a.click();
            showToast('CSV Exported successfully!');
        }


        // Helper to update the Live Transaction Card
        function updateLiveCard(txn) {
            if (!txn) return;
            const noteEl = document.getElementById('liveCardNote');
            const nameEl = document.getElementById('liveCardName');
            const linkEl = document.getElementById('liveCardTxnLink');
            const amtEl = document.getElementById('liveCardAmount');
            const cardEl = document.getElementById('liveHighlightCard');

            const note = txn.transaction_note || '—';
            const cleanId = String(txn.transaction_id || '').trim();
            const amt = Number(txn.amount || 0);

            if (noteEl) noteEl.innerText = note;
            if (nameEl) nameEl.innerText = txn.name || 'Customer';
            if (linkEl && cleanId) {
                linkEl.innerText = cleanId;
                linkEl.href = `https://business.phonepe.com/dashboard/transactions/details/${cleanId}`;
            }
            if (amtEl) amtEl.innerText = amt.toLocaleString('en-IN', {minimumFractionDigits: 2});

            if (cardEl) {
                cardEl.style.transform = 'scale(1.02)';
                cardEl.style.boxShadow = '0 0 20px rgba(168, 85, 247, 0.4)';
                setTimeout(() => {
                    cardEl.style.transform = 'scale(1)';
                    cardEl.style.boxShadow = '0 1px 3px rgba(0, 0, 0, 0.04)';
                }, 1000);
            }
        }

        // Prepend new live transaction quietly to the table (NO POPUPS & 100% STABLE DEDUPLICATION)
        function prependLiveTransaction(txn) {
            const tbody = document.getElementById('tableBody');
            if (!tbody || !txn || !txn.transaction_id) return;

            const cleanId = String(txn.transaction_id).trim();
            const noteText = txn.transaction_note || '';
            const custName = txn.name || 'Customer';
            const status = txn.status || 'PAYMENT_SUCCESS';
            const statusClass = /SUCCESS|COMPLETED|PAID/i.test(status) ? 'status-success' : 'status-pending';
            const amountVal = parseFloat(txn.amount || 0);

            const noteHtml = (noteText && noteText !== '—')
                ? `<div class="note-badge" title="Click to copy note" onclick="copyText('${noteText}')">
                     <span>${noteText}</span>
                     <button class="copy-btn">📋</button>
                   </div>`
                : '<span class="text-muted" style="font-style:italic; color:#94a3b8;">—</span>';

            const existingRow = document.querySelector(`tr[data-txn-id="${cleanId}"]`) || document.getElementById(`txn-row-${cleanId}`);
            if (existingRow) {
                // Update existing row in place
                if (existingRow.children.length >= 7) {
                    if (noteText) existingRow.children[2].innerHTML = noteHtml;
                    if (custName && custName !== 'Customer') existingRow.children[3].innerText = custName;
                    if (amountVal > 0) existingRow.children[4].innerText = `₹ ${amountVal.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
                    existingRow.children[5].innerHTML = `<span class="status-badge ${statusClass}">● ${status}</span>`;
                }
                existingRow.classList.add('row-new');
                setTimeout(() => existingRow.classList.remove('row-new'), 3000);
                showToast('⚡ Updated: ₹' + amountVal.toFixed(2) + (noteText ? ' (' + noteText + ')' : ''));
                return;
            }

            const placeholder = tbody.querySelector('.empty-placeholder');
            if (placeholder) placeholder.remove();

            const tr = document.createElement('tr');
            tr.className = 'row-new';
            tr.id = `txn-row-${cleanId}`;
            tr.setAttribute('data-txn-id', cleanId);
            tr.setAttribute('data-search', `${cleanId} ${noteText} ${custName} ${status} ${amountVal}`.toLowerCase());
            
            const fDate = txn.transaction_date || 'Just now';

            tr.innerHTML = `
                <td style="color:#15803d; font-weight:bold; width:40px;">⚡</td>
                <td>
                    <a href="https://business.phonepe.com/dashboard/transactions/details/${cleanId}" target="_blank" class="id-badge" title="Open PhonePe Details">
                        <span>${cleanId}</span>
                        <button class="copy-btn" onclick="event.preventDefault(); copyText('${cleanId}')" title="Copy ID">📋</button>
                    </a>
                </td>
                <td>${noteHtml}</td>
                <td style="font-weight:600; color:#1e293b;">${custName}</td>
                <td class="amount-text" style="color:#15803d; font-weight:700;">₹ ${amountVal.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                <td><span class="status-badge ${statusClass}">● ${status}</span></td>
                <td style="font-size:13px; color:#475569;">${fDate}</td>
            `;

            tbody.prepend(tr);

            // Update stats cards safely and accurately
            try {
                const countEl = document.getElementById('statTotalCount');
                const totalEl = document.getElementById('totalCount');
                const visEl = document.getElementById('visibleCount');
                const amtEl = document.getElementById('statTotalAmount');
                const sTot = document.getElementById('statSuccessTotal');
                const sCount = document.getElementById('statSuccessCount');

                const currentCount = tbody.querySelectorAll('tr:not(.empty-placeholder)').length;
                if (countEl) countEl.innerText = currentCount;
                if (totalEl) totalEl.innerText = currentCount;
                if (visEl) visEl.innerText = currentCount;
                if (sTot) sTot.innerText = currentCount;
                if (sCount) {
                    const currentSucc = parseInt(sCount.innerText || 0) + 1;
                    sCount.innerText = currentSucc;
                }

                if (amtEl) {
                    const rawAmt = parseFloat(amtEl.innerText.replace(/[^\d.]/g, '') || 0);
                    const newAmt = rawAmt + amountVal;
                    amtEl.innerText = newAmt.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 2});
                }
            } catch (err) {}

            showToast('⚡ Live payment received: ₹' + amountVal.toFixed(2) + (noteText ? ' (' + noteText + ')' : ''));
        }

        // Live EventSource Stream for instant table updates
        function connectLiveStream() {
            try {
                const sse = new EventSource('/api/v1/live/stream');
                sse.onopen = function() {
                    console.log('⚡ [Live SSE] Connected to backend live stream');
                };
                sse.onmessage = function(e) {
                    try {
                        const data = JSON.parse(e.data);
                        console.log('⚡ [Live SSE] Message received:', data);
                        if (data && (data.event === 'NEW_TRANSACTION' || data.transaction_id)) {
                            prependLiveTransaction(data);
                        }
                    } catch (err) {}
                };
                sse.onerror = function() {
                    console.warn('SSE disconnected, reconnecting in 3s...');
                    sse.close();
                    setTimeout(connectLiveStream, 3000);
                };
            } catch (e) {}
        }

        // Stable asynchronous hydration (no page reloads)
        async function refreshTableData() {
            try {
                const resp = await fetch('/api/v1/db/transactions?limit=500');
                if (!resp.ok) return;
                const json = await resp.json();
                if (!json || !json.data || !json.data.length) return;

                const tbody = document.getElementById('tableBody');
                if (!tbody) return;

                let html = '';
                let totalAmt = 0;
                let successCount = 0;

                json.data.forEach((t, idx) => {
                    const cleanId = String(t.transaction_id || 'N/A').trim();
                    const note = t.transaction_note || '';
                    const amt = parseFloat(t.amount || 0);
                    totalAmt += amt;
                    const name = t.name || 'Customer';
                    const status = t.status || 'COMPLETED';
                    if (/SUCCESS|COMPLETED|PAID/i.test(status)) successCount++;
                    const dateRaw = String(t.transaction_date || '');
                    let fDate = dateRaw;
                    if (dateRaw.length >= 12 && /^\d+$/.test(dateRaw)) {
                        try {
                            fDate = new Date(parseInt(dateRaw, 10)).toLocaleString();
                        } catch (e) {}
                    }

                    const noteHtml = (note && note !== '—')
                        ? `<div class="note-badge" title="Click to copy note" onclick="copyText('${note}')">
                             <span>${note}</span>
                             <button class="copy-btn">📋</button>
                           </div>`
                        : '<span class="text-muted" style="font-style:italic; color:#94a3b8;">—</span>';

                    const statusClass = /SUCCESS|COMPLETED|PAID/i.test(status) ? 'status-success' : 'status-pending';

                    html += `
                    <tr id="txn-row-${cleanId}" data-txn-id="${cleanId}" data-search="${cleanId.toLowerCase()} ${String(note).toLowerCase()} ${String(name).toLowerCase()} ${status.toLowerCase()} ${amt}">
                        <td style="font-weight:600; color:#64748b; width:40px;">${idx + 1}</td>
                        <td>
                            <a href="https://business.phonepe.com/dashboard/transactions/details/${cleanId}" target="_blank" class="id-badge" title="Open PhonePe Details Link">
                                <span>${cleanId}</span>
                                <button class="copy-btn" onclick="event.preventDefault(); copyText('${cleanId}')" title="Copy ID">📋</button>
                            </a>
                        </td>
                        <td>${noteHtml}</td>
                        <td style="font-weight:600; color:#1e293b;">${name}</td>
                        <td class="amount-text" style="color:#0f172a; font-weight:700;">₹ ${amt.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                        <td><span class="status-badge ${statusClass}">● ${status}</span></td>
                        <td style="font-size:13px; color:#475569;">${fDate}</td>
                    </tr>
                    `;
                });

                tbody.innerHTML = html;
                const count = json.data.length;
                const cEl = document.getElementById('statTotalCount');
                if (cEl) cEl.innerText = count;
                const tEl = document.getElementById('totalCount');
                if (tEl) tEl.innerText = count;
                const vEl = document.getElementById('visibleCount');
                if (vEl) vEl.innerText = count;
                
                const amtEl = document.getElementById('statTotalAmount');
                if (amtEl) amtEl.innerText = totalAmt.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 2});
                
                const sCount = document.getElementById('statSuccessCount');
                if (sCount) sCount.innerText = successCount;
                const sTot = document.getElementById('statSuccessTotal');
                if (sTot) sTot.innerText = count;
            } catch (e) {
                console.error('Table refresh error:', e);
            }
        }

        function initDashboard() {
            refreshTableData();
            connectLiveStream();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initDashboard);
        } else {
            initDashboard();
        }
    </script>
