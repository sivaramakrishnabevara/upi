nts-note {\n  font-size: 12px;\n  color: #64748b;\n  text-align: center;\n  margin-top: 8px;\n}\n\n/* Punch Success Banner */\n.punch-success-banner {\n  margin-top: 20px;\n  background: #ffffff;\n  border: 2px solid #86efac;\n  border-radius: 14px;\n  padding: 20px;\n  box-shadow: 0 8px 24px rgba(22, 163, 74, 0.15);\n  animation: fadeIn 0.4s ease;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.success-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding-bottom: 14px;\n  border-bottom: 1px solid #f1f5f9;\n}\n\n.success-icon {\n  color: #16a34a;\n  flex-shrink: 0;\n}\n\n.success-header h3 {\n  font-size: 17px;\n  font-weight: 800;\n  color: #0f172a;\n}\n\n.status-present {\n  color: #16a34a;\n  font-weight: 800;\n}\n\n.success-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-top: 14px;\n}\n\n.success-grid div {\n  background: #f8fafc;\n  padding: 10px 12px;\n  border-radius: 8px;\n}\n\n.success-grid span {\n  display: block;\n  font-size: 11px;\n  color: #64748b;\n}\n\n.success-grid strong {\n  display: block;\n  font-size: 13px;\n  color: #0f172a;\n  margin-top: 2px;\n}\n\n.success-footer-actions {\n  margin-top: 14px;\n}\n\n.btn-go-dashboard {\n  display: block;\n  text-align: center;\n  background: #0284c7;\n  color: #ffffff;\n  font-weight: 700;\n  font-size: 13px;\n  padding: 10px;\n  border-radius: 8px;\n  transition: all 0.2s;\n}\n\n.btn-go-dashboard:hover {\n  background: #0369a1;\n}\n\n/* =========================================================\n   ADMIN DASHBOARD ATTENDANCE TAB & ROSTER TABLE\n========================================================= */\n\n.dash-badge {\n  display: inline-block;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.8px;\n  color: #0284c7;\n  background: #e0f2fe;\n  padding: 3px 10px;\n  border-radius: 999px;\n  margin-bottom: 4px;\n}\n\n.dash-subtext {\n  font-size: 13px;\n  color: #64748b;\n  margin-top: 4px;\n}\n\n.dash-header-actions {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.btn-admin-logout {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  background: #fef2f2;\n  color: #dc2626;\n  border: 1px solid #fecaca;\n  padding: 6px 14px;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-admin-logout:hover {\n  background: #fee2e2;\n  border-color: #fca5a5;\n  color: #b91c1c;\n  transform: translateY(-1px);\n}\n\n.dashboard-tab-bar {\n  display: flex;\n  gap: 12px;\n  margin: 24px 0 20px;\n  border-bottom: 1px solid #e2e8f0;\n  padding-bottom: 10px;\n}\n\n.dash-tab-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: transparent;\n  border: none;\n  padding: 10px 18px;\n  border-radius: 8px;\n  font-size: 14px;\n  font-weight: 700;\n  color: #64748b;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.dash-tab-btn:hover {\n  color: #0284c7;\n  background: #f0f7ff;\n}\n\n.dash-tab-btn.active {\n  color: #0284c7;\n  background: #e0f2fe;\n}\n\n.tab-pill {\n  font-size: 11px;\n  font-weight: 800;\n  padding: 2px 8px;\n  border-radius: 999px;\n  background: #0284c7;\n  color: #ffffff;\n}\n\n/* KPI GRID */\n.attendance-kpi-grid {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 18px;\n  margin-bottom: 24px;\n}\n\n.att-kpi-card {\n  background: #ffffff;\n  border-radius: 14px;\n  padding: 18px;\n  border: 1px solid #e2e8f0;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.att-kpi-icon {\n  width: 46px;\n  height: 46px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.att-kpi-icon.blue { background: #e0f2fe; color: #0284c7; }\n.att-kpi-icon.green { background: #dcfce7; color: #16a34a; }\n.att-kpi-icon.red { background: #fee2e2; color: #dc2626; }\n.att-kpi-icon.purple { background: #f3e8ff; color: #9333ea; }\n.att-kpi-icon.cyan { background: #cffafe; color: #0891b2; }\n\n.att-kpi-card p {\n  font-size: 12px;\n  color: #64748b;\n  font-weight: 600;\n}\n\n.att-kpi-card h2 {\n  font-size: 22px;\n  font-weight: 800;\n  color: #0f172a;\n  margin: 1px 0;\n}\n\n.kpi-sub {\n  font-size: 11px;\n  color: #94a3b8;\n  display: block;\n}\n\n.text-green { color: #16a34a !important; }\n.text-red { color: #dc2626 !important; }\n.text-purple { color: #7c3aed !important; }\n\n/* TABLE TOOLBAR */\n.att-table-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 18px;\n  flex-wrap: wrap;\n}\n\n.toolbar-left {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex: 1;\n  min-width: 320px;\n}\n\n.search-input-box {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  background: #ffffff;\n  border: 1px solid #cbd5e1;\n  padding: 8px 14px;\n  border-radius: 8px;\n  flex: 1;\n  max-width: 380px;\n}\n\n.search-input-box input {\n  border: none;\n  outline: none;\n  font-size: 13px;\n  width: 100%;\n}\n\n.search-input-box svg {\n  color: #94a3b8;\n}\n\n.filter-buttons-group {\n  display: flex;\n  gap: 6px;\n}\n\n.btn-filter {\n  background: #ffffff;\n  border: 1px solid #cbd5e1;\n  color: #475569;\n  font-size: 12px;\n  font-weight: 700;\n  padding: 7px 12px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-filter:hover {\n  background: #f1f5f9;\n}\n\n.btn-filter.active {\n  background: #0284c7;\n  border-color: #0284c7;\n  color: #ffffff;\n}\n\n.toolbar-right {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.btn-toolbar-settings {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: #ffffff;\n  border: 1px solid #cbd5e1;\n  color: #334155;\n  font-size: 13px;\n  font-weight: 700;\n  padding: 8px 14px;\n  border-radius: 8px;\n  transition: all 0.2s;\n}\n\n.btn-toolbar-settings:hover {\n  background: #f8f