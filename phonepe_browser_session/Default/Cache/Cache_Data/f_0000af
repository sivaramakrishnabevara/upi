 margin-top: 14px;\n}\n\n.footer-cert-tags span {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  color: #38bdf8;\n  font-weight: 600;\n}\n\n/* MAIN FOOTER COLUMNS */\n.footer-container {\n  max-width: 1250px;\n  margin: auto;\n  padding: 65px 5%;\n  display: grid;\n  grid-template-columns: 1.5fr 1fr 1.2fr 1fr;\n  gap: 45px;\n}\n\n.footer-company p,\n.footer-column p {\n  color: #94a3b8;\n  line-height: 1.7;\n  font-size: 14px;\n}\n\n.footer-column {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.footer-column h3 {\n  font-family: \"Montserrat\", sans-serif;\n  margin-bottom: 8px;\n  font-size: 16px;\n  color: #ffffff;\n}\n\n.footer-column a {\n  color: #94a3b8;\n  font-size: 14px;\n  transition: all 0.2s ease;\n}\n\n.footer-column a:hover {\n  color: var(--accent-cyan);\n  padding-left: 4px;\n}\n\n/* POLICY BUTTONS IN FOOTER */\n.footer-policy-btn {\n  background: none;\n  border: none;\n  color: #94a3b8;\n  font-size: 14px;\n  font-weight: 500;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  cursor: pointer;\n  padding: 4px 0;\n  text-align: left;\n  transition: all 0.2s ease;\n}\n\n.footer-policy-btn:hover {\n  color: var(--accent-cyan);\n  padding-left: 5px;\n}\n\n.footer-contact {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  color: #94a3b8;\n  font-size: 14px;\n}\n\n.footer-contact svg {\n  color: var(--accent-cyan);\n  flex-shrink: 0;\n  margin-top: 3px;\n}\n\n.footer-hours {\n  margin-top: 16px;\n  padding-top: 14px;\n  border-top: 1px dashed rgba(255, 255, 255, 0.12);\n}\n\n.footer-hours h4 {\n  font-size: 13px;\n  font-weight: 700;\n  color: #cbd5e1;\n  margin-bottom: 4px;\n}\n\n.footer-hours p {\n  font-size: 12.5px;\n  color: #94a3b8;\n  line-height: 1.5;\n}\n\n/* BOTTOM COPYRIGHT & POLICY LINKS */\n.footer-bottom {\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  padding: 22px 5%;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: #64748b;\n  font-size: 12px;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.footer-bottom-left {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.footer-bottom-links {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.footer-bottom-links button,\n.footer-bottom-links a {\n  background: none;\n  border: none;\n  color: #94a3b8;\n  font-size: 12px;\n  cursor: pointer;\n  transition: color 0.2s ease;\n}\n\n.footer-bottom-links button:hover,\n.footer-bottom-links a:hover {\n  color: var(--accent-cyan);\n  text-decoration: underline;\n}\n\n/* POLICY MODAL */\n.policy-modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(11, 25, 44, 0.78);\n  backdrop-filter: blur(8px);\n  z-index: 999;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  animation: fadeIn 0.25s ease;\n}\n\n.policy-modal-box {\n  background: #ffffff;\n  border-radius: 20px;\n  width: 100%;\n  max-width: 680px;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);\n  overflow: hidden;\n  border: 1px solid #cbd5e1;\n  animation: scaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.policy-modal-header {\n  padding: 20px 26px;\n  background: #f8fafc;\n  border-bottom: 1px solid #e2e8f0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.policy-modal-title {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.policy-modal-title h3 {\n  font-family: \"Montserrat\", sans-serif;\n  font-size: 18px;\n  font-weight: 800;\n  color: #0f172a;\n}\n\n.policy-modal-close {\n  background: #f1f5f9;\n  border: none;\n  width: 34px;\n  height: 34px;\n  border-radius: 8px;\n  display: grid;\n  place-items: center;\n  color: #64748b;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.policy-modal-close:hover {\n  background: #fee2e2;\n  color: #ef4444;\n}\n\n.policy-modal-nav {\n  display: flex;\n  gap: 6px;\n  padding: 12px 26px;\n  background: #ffffff;\n  border-bottom: 1px solid #e2e8f0;\n  overflow-x: auto;\n}\n\n.policy-modal-nav button {\n  padding: 7px 14px;\n  border-radius: 8px;\n  border: 1px solid #e2e8f0;\n  background: #f8fafc;\n  font-size: 12.5px;\n  font-weight: 700;\n  color: #475569;\n  white-space: nowrap;\n  transition: all 0.2s ease;\n}\n\n.policy-modal-nav button.active {\n  background: #0284c7;\n  color: #ffffff;\n  border-color: #0284c7;\n}\n\n.policy-modal-body {\n  padding: 24px 26px;\n  overflow-y: auto;\n  font-size: 14px;\n  color: #334155;\n  line-height: 1.65;\n}\n\n.policy-text-section h4 {\n  font-family: \"Montserrat\", sans-serif;\n  font-size: 15px;\n  font-weight: 700;\n  color: #0f172a;\n  margin: 16px 0 6px;\n}\n\n.policy-text-section h4:first-child {\n  margin-top: 0;\n}\n\n.policy-text-section p {\n  color: #64748b;\n  margin-bottom: 12px;\n}\n\n.policy-modal-footer {\n  padding: 16px 26px;\n  border-top: 1px solid #e2e8f0;\n  background: #f8fafc;\n  display: flex;\n  justify-content: flex-end;\n}\n\n/* =========================================================\n   MOBILE RESPONSIVENESS\n========================================================= */\n\n.mobile-menu {\n  display: none;\n}\n\n@media (max-width: 1200px) {\n  .desktop-nav {\n    gap: 20px;\n  }\n\n  .real-logo {\n    height: 82px;\n    width: auto;\n    max-width: 240px;\n  }\n\n  .footer-partners-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .service-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .dashboard-stats {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (max-width: 1000px) {\n  .desktop-nav,\n  .nav-book-button {\n    display: none;\n  }\n\n  .mobile-toggle {\n    display: block;\n  }\n\n  .mobile-menu {\n    position: absolute;\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    top: 100%;\n    left: 0;\n    right: 0;\n    background: #ffffff;\n    padding: 20px;\n    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);\n    z-index: 99;\n    border-bottom: 2px solid var(--primary-blue);\n  }\n\n  .mobile-menu a {\n    padding: 14px;\n    font-weight: 700;\n    color: #1e293b;\n    border-radius: 8px;\n  }\n\n  .mobile-menu a:hover {\n    background: var(--light-blue);\n    color: var(--primary-blue);\n  }\n\n  .mobile-book,\n  .mobile-login {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .features-section {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .feature-box:nth-child(2) {\n    border-right: none;\n  }\n\n  .about-home,\n  .about-page-section {\n    grid-template-columns: 1fr;\n    gap: 40px;\n  }\n\n  .contact-grid,\n  .booking-container {\n    grid-template-columns: 1fr;\n    gap: 40px;\n  }\n\n  .dashboard-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .footer-container {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .footer-partners-grid {\n    grid-template-columns: 1fr;\n    gap: 18px;\n  }\n}\n\n@media (max-width: 700px) {\n  .top-bar {\n    padding: 8px 15px;\n  }\n\n  .top-info {\n    display: none;\n  }\n\n  .navbar {\n    min-height: 95px;\n    padding: 0 16px;\n  }\n\n  .real-logo {\n    height: 72px;\n    width: auto;\n    max-width: 200px;\n  }\n\n  .hero-section {\n    min-height: 560px;\n  }\n\n  .hero-content h1 {\n    font-size: 40px;\n  }\n\n  .hero-buttons {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .features-section {\n    grid-template-columns: 1fr;\n  }\n\n  .service-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .dashboard-stats {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .footer-container {\n    grid-template-columns: 1fr;\n    gap: 35px;\n  }\n\n  .footer-brand-box .footer-logo {\n    height: 78px;\n    width: auto;\n    max-width: 220px;\n  }\n\n  .footer-bottom {\n    flex-direction: column;\n    text-align: center;\n    gap: 12px;\n  }\n\n  .footer-bottom-links {\n    justify-content: center;\n  }\n}\n\n/* =========================================================\n   HEADER ATTENDANCE BUTTON & TOP BAR ACTIONS\n========================================================= */\n\n.top-user-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.top-attendance {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: #ffffff;\n  font-weight: 700;\n  font-size: 13px;\n  padding: 4px 12px;\n  border-radius: 6px;\n  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);\n  border: 1px solid rgba(56, 189, 248, 0.4);\n  box-shadow: 0 2px 8px rgba(2, 132, 199, 0.25);\n  transition: all 0.25s ease;\n}\n\n.top-attendance:hover {\n  background: linear-gradient(135deg, #0369a1 0%, #075985 100%);\n  border-color: #38bdf8;\n  transform: translateY(-1px);\n  box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);\n}\n\n.mobile-attendance {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);\n  color: #ffffff !important;\n  font-weight: 700;\n  padding: 12px 20px;\n  border-radius: 8px;\n  margin-top: 6px;\n  border: 1px solid rgba(56, 189, 248, 0.3);\n}\n\n/* =========================================================\n   ATTENDANCE PAGE STYLES (50M GEOFENCE & FACE SCANNER)\n========================================================= */\n\n.attendance-page {\n  padding: 30px 5% 60px;\n  background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);\n  min-height: calc(100vh - 120px);\n}\n\n.attendance-header-card {\n  background: linear-gradient(135deg, #0b192c 0%, #075985 60%, #0284c7 100%);\n  border-radius: 16px;\n  padding: 28px 36px;\n  color: #ffffff;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  box-shadow: 0 10px 25px rgba(11, 25, 44, 0.15);\n  margin-bottom: 30px;\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.badge-glow {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.8px;\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: rgba(56, 189, 248, 0.2);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.4);\n  margin-bottom: 8px;\n}\n\n.attendance-header-left h1 {\n  font-size: 28px;\n  font-weight: 800;\n  margin: 6px 0;\n  color: #ffffff;\n  letter-spacing: -0.5px;\n}\n\n.attendance-header-left p {\n  color: #cbd5e1;\n  font-size: 14px;\n  max-width: 620px;\n  line-height: 1.5;\n}\n\n.attendance-header-right {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 12px;\n}\n\n.office-info-pill {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: rgba(255, 255, 255, 0.1);\n  backdrop-filter: blur(8px);\n  padding: 10px 16px;\n  border-radius: 12px;\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  text-align: left;\n}\n\n.office-icon {\n  color: #38bdf8;\n  flex-shrink: 0;\n}\n\n.office-info-pill strong {\n  display: block;\n  font-size: 13px;\n  color: #ffffff;\n}\n\n.office-info-pill span {\n  display: block;\n  font-size: 11px;\n  color: #94a3b8;\n}\n\n.view-dashboard-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  font-weight: 700;\n  color: #38bdf8;\n  padding: 6px 14px;\n  border-radius: 6px;\n  background: rgba(56, 189, 248, 0.1);\n  border: 1px solid rgba(56, 189, 248, 0.3);\n  transition: all 0.2s ease;\n}\n\n.view-dashboard-link:hover {\n  background: #38bdf8;\n  color: #0b192c;\n}\n\n.attendance-container {\n  display: grid;\n  grid-template-columns: 1fr 1.15fr;\n  gap: 28px;\n}\n\n.attendance-col {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.att-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 24px;\n  border: 1px solid #e2e8f0;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);\n}\n\n.att-card-header {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding-bottom: 14px;\n  border-bottom: 1px solid #f1f5f9;\n}\n\n.step-num {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: #0284c7;\n  color: #ffffff;\n  font-weight: 800;\n  font-size: 14px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.att-card-header h3 {\n  font-size: 17px;\n  font-weight: 700;\n  color: #0f172a;\n}\n\n.att-card-header p {\n  font-size: 12px;\n  color: #64748b;\n  margin-top: 2px;\n}\n\n.att-select {\n  width: 100%;\n  padding: 11px 14px;\n  border: 1.5px solid #cbd5e1;\n  border-radius: 8px;\n  font-size: 14px;\n  font-weight: 600;\n  color: #0f172a;\n  background: #f8fafc;\n  outline: none;\n  transition: border-color 0.2s;\n}\n\n.att-select:focus {\n  border-color: #0284c7;\n  background: #ffffff;\n  box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);\n}\n\n.emp-preview-box {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-top: 16px;\n  padding: 14px;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n}\n\n.emp-preview-photo {\n  width: 64px;\n  height: 64px;\n  border-radius: 12px;\n  object-fit: cover;\n  border: 2px solid #0284c7;\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);\n}\n\n.emp-preview-meta h4 {\n  font-size: 15px;\n  font-weight: 700;\n  color: #0f172a;\n}\n\n.emp-id-badge {\n  display: inline-block;\n  font-size: 11px;\n  font-weight: 800;\n  color: #0284c7;\n  background: #e0f2fe;\n  padding: 2px 8px;\n  border-radius: 4px;\n  margin: 3px 0;\n}\n\n.emp-role-text {\n  font-size: 12px;\n  font-weight: 600;\n  color: #334155;\n}\n\n.emp-dept-text {\n  font-size: 11px;\n  color: #64748b;\n}\n\n.emp-shift-tag {\n  display: inline-block;\n  font-size: 11px;\n  color: #475569;\n  background: #e2e8f0;\n  padding: 1px 6px;\n  border-radius: 4px;\n  margin-top: 4px;\n}\n\n.already-marked-alert {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-top: 14px;\n  padding: 12px 14px;\n  background: #ecfdf5;\n  border: 1px solid #a7f3d0;\n  border-radius: 8px;\n  color: #065f46;\n}\n\n.already-marked-alert strong {\n  display: block;\n  font-size: 13px;\n}\n\n.already-marked-alert p {\n  font-size: 12px;\n  margin-top: 2px;\n}\n\n.id-privacy-notice {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 10px;\n  padding: 12px 16px;\n  font-size: 13px;\n  color: #64748b;\n  margin-top: 14px;\n}\n\n.id-privacy-notice svg {\n  color: #0284c7;\n  flex-shrink: 0;\n}\n\n.id-verified-success-banner {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: #f0fdf4;\n  border: 1.5px solid #86efac;\n  border-radius: 12px;\n  padding: 14px 18px;\n  margin-top: 16px;\n  animation: fadeIn 0.3s ease;\n}\n\n.id-verified-success-banner strong {\n  display: block;\n  font-size: 14px;\n  color: #15803d;\n  font-weight: 700;\n}\n\n.id-verified-success-banner span {\n  font-size: 13px;\n  color: #166534;\n}\n\n.mini-avatar-placeholder {\n  width: 42px;\n  height: 42px;\n  border-radius: 50%;\n  background: #e0f2fe;\n  color: #0284c7;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n/* GEOFENCE 50M STATUS */\n.geofence-status-container {\n  margin-top: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.geo-loading,\n.geo-idle {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 16px;\n  background: #f8fafc;\n  border: 1px dashed #cbd5e1;\n  border-radius: 10px;\n  font-size: 13px;\n  color: #64748b;\n}\n\n.spin-icon {\n  animation: spin 1s linear infinite;\n  color: #0284c7;\n}\n\n@keyframes spin {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}\n\n.geo-result-box {\n  display: flex;\n  align-items: flex-start;\n  gap: 14px;\n  padding: 16px;\n  border-radius: 12px;\n}\n\n.geo-result-box.geo-success {\n  background: #f0fdf4;\n  border: 1.5px solid #86efac;\n  color: #14532d;\n}\n\n.geo-result-box.geo-failed {\n  background: #fef2f2;\n  border: 1.5px solid #fca5a5;\n  color: #991b1b;\n}\n\n.geo-result-icon {\n  flex-shrink: 0;\n  margin-top: 2px;\n}\n\n.geo-success .geo-result-icon {\n  color: #16a34a;\n}\n\n.geo-failed .geo-result-icon {\n  color: #dc2626;\n}\n\n.geo-result-info h4 {\n  font-size: 14px;\n  font-weight: 700;\n  margin-bottom: 4px;\n}\n\n.geo-result-info p {\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.coords-text {\n  display: block;\n  font-size: 11px;\n  opacity: 0.8;\n  margin-top: 4px;\n}\n\n.geo-error-box {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: #dc2626;\n  background: #fff1f2;\n  padding: 8px 12px;\n  border-radius: 6px;\n}\n\n.geo-actions-row {\n  display: flex;\n  gap: 10px;\n  margin-top: 6px;\n  flex-wrap: wrap;\n}\n\n.btn-geo-check {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: #0284c7;\n  color: #ffffff;\n  border: none;\n  padding: 9px 16px;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 700;\n  transition: all 0.2s;\n}\n\n.btn-geo-check:hover:not(:disabled) {\n  background: #0369a1;\n  transform: translateY(-1px);\n}\n\n.btn-demo-office {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: #e0f2fe;\n  color: #0369a1;\n  border: 1px dashed #0284c7;\n  padding: 9px 14px;\n  border-radius: 8px;\n  font-size: 12px;\n  font-weight: 700;\n  transition: all 0.2s;\n}\n\n.btn-demo-office:hover {\n  background: #bae6fd;\n}\n\n/* =========================================================\n   LIVE BIOMETRIC CAMERA & SCANNER VIEWPORT\n========================================================= */\n\n.camera-viewport-box {\n  margin-top: 16px;\n  background: #0b192c;\n  border-radius: 14px;\n  overflow: hidden;\n  position: relative;\n  aspect-ratio: 4 / 3;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 2px solid #1e293b;\n}\n\n.camera-placeholder {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  color: #94a3b8;\n  text-align: center;\n  padding: 24px;\n}\n\n.camera-placeholder-icon {\n  color: #38bdf8;\n  margin-bottom: 12px;\n}\n\n.camera-placeholder h4 {\n  color: #ffffff;\n  font-size: 16px;\n  font-weight: 700;\n  margin-bottom: 4px;\n}\n\n.camera-placeholder p {\n  font-size: 12px;\n  color: #94a3b8;\n}\n\n.video-stream-wrapper {\n  width: 100%;\n  height: 100%;\n  position: relative;\n}\n\n.live-video {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transform: scaleX(-1); /* mirror view for natural selfie */\n}\n\n/* Face Framing Oval & Scanning Line */\n.face-guide-oval {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  width: 190px;\n  height: 250px;\n  border-radius: 50%;\n  border: 2.5px dashed #38bdf8;\n  box-shadow: 0 0 0 9999px rgba(11, 25, 44, 0.45);\n  pointer-events: none;\n  overflow: hidden;\n  animation: pulse-border 2s infinite ease-in-out;\n}\n\n@keyframes pulse-border {\n  0%, 100% { border-color: #38bdf8; }\n  50% { border-color: #0284c7; }\n}\n\n.scanner-line {\n  position: absolute;\n  width: 100%;\n  height: 2px;\n  background: linear-gradient(90deg, transparent 0%, #38bdf8 50%, transparent 100%);\n  box-shadow: 0 0 8px #38bdf8;\n  animation: scan-vertical 2.2s infinite ease-in-out;\n}\n\n@keyframes scan-vertical {\n  0% { top: 0%; }\n  50% { top: 98%; }\n  100% { top: 0%; }\n}\n\n.camera-instructions {\n  position: absolute;\n  bottom: 12px;\n  left: 50%;\n  transform: translateX(-50%);\n  background: rgba(15, 23, 42, 0.85);\n  backdrop-filter: blur(6px);\n  color: #ffffff;\n  padding: 6px 14px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  white-space: nowrap;\n  border: 1px solid rgba(255, 255, 255, 0.15);\n}\n\n.captured-preview-wrapper {\n  width: 100%;\n  height: 100%;\n  position: relative;\n}\n\n.captured-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.captured-overlay-tag {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  background: #16a34a;\n  color: #ff